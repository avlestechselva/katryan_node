<div class="container">
  <div class="row">
    <div class="col-md-12">
      <h2>Property Sales</h2>
      <hr>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <form method="get" action="/search/sales/results" class="form-horizontal">

        <div class="form-group">
          <label class="col-sm-3 control-label" for="priceLow">Price From</label>
          <div class="col-sm-5">
            <select class="form-control" id="priceLow" name="priceLow">
              <option value="0">No Minimum</option>
              <% for (var p = 25000; p <= 500000; p += 25000) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %></option>
              <% } %>
              <% for (var p = 550000; p <= 1000000; p += 50000) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="priceHigh">Price To</label>
          <div class="col-sm-5">
            <select class="form-control" id="priceHigh" name="priceHigh">
              <option value="0">No Maximum</option>
              <% for (var p = 25000; p <= 500000; p += 25000) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %></option>
              <% } %>
              <% for (var p = 550000; p <= 1000000; p += 50000) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="beds">Bedrooms</label>
          <div class="col-sm-5">
            <select class="form-control" id="beds" name="beds">
              <option value="">Any</option>
              <option value="0">Studio</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5+</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="proType">Property Type</label>
          <div class="col-sm-5">
            <select class="form-control" id="proType" name="proType">
              <option value="">Any</option>
              <option value="House">House</option>
              <option value="Flat">Flat</option>
              <option value="Studio">Studio</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="area">Area</label>
          <div class="col-sm-5">
            <select class="form-control" id="area" name="area">
              <option value="">All Areas</option>
              <option value="Ladbroke Grove">Ladbroke Grove</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="postcode">Postcode</label>
          <div class="col-sm-5">
            <input type="text" class="form-control" id="postcode" name="postcode" placeholder="e.g. W2">
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="orderBy">Order By</label>
          <div class="col-sm-5">
            <select class="form-control" id="orderBy" name="orderBy">
              <option value="PriceAsk">Lowest price first</option>
              <option value="PriceAskd">Highest price first</option>
              <option value="Postcode">Post Code</option>
              <option value="Address4">Area</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="perPage">Properties Per Page</label>
          <div class="col-sm-5">
            <select class="form-control" id="perPage" name="perPage">
              <option value="5">5</option>
              <option value="7">7</option>
              <option value="10" selected>10</option>
              <option value="15">15</option>
              <option value="20">20</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <div class="col-sm-offset-3 col-sm-9">
            <button type="submit" class="btn btn-primary">Search</button>
            &nbsp;
            <a href="/search/sales/results" class="btn btn-default">View All</a>
            &nbsp;
            <button type="reset" class="btn btn-default">Reset</button>
          </div>
        </div>

      </form>
    </div>

    <div class="col-md-4">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title">Fast Searches</h3>
        </div>
        <div class="panel-body">

          <h5><strong>By Bedrooms</strong></h5>
          <ul class="list-unstyled">
            <li><a href="/search/sales/results?beds=0">Studio properties</a></li>
            <li><a href="/search/sales/results?beds=1">1 Bedroom properties</a></li>
            <li><a href="/search/sales/results?beds=2">2 Bedroom properties</a></li>
            <li><a href="/search/sales/results?beds=3">3 Bedroom properties</a></li>
            <li><a href="/search/sales/results?beds=4">4 Bedroom properties</a></li>
            <li><a href="/search/sales/results?beds=5">5+ Bedroom properties</a></li>
          </ul>

          <h5><strong>By Price Range</strong></h5>
          <ul class="list-unstyled">
            <li><a href="/search/sales/results?priceLow=0&priceHigh=100000">Under £100,000</a></li>
            <li><a href="/search/sales/results?priceLow=100000&priceHigh=200000">£100,000 – £200,000</a></li>
            <li><a href="/search/sales/results?priceLow=200000&priceHigh=300000">£200,000 – £300,000</a></li>
            <li><a href="/search/sales/results?priceLow=300000&priceHigh=500000">£300,000 – £500,000</a></li>
            <li><a href="/search/sales/results?priceLow=500000&priceHigh=750000">£500,000 – £750,000</a></li>
            <li><a href="/search/sales/results?priceLow=750000&priceHigh=1000000">£750,000 – £1,000,000</a></li>
            <li><a href="/search/sales/results?priceLow=1000000&priceHigh=0">Over £1,000,000</a></li>
          </ul>

        </div>
      </div>
    </div>
  </div>
</div>
