<div class="container">
  <div class="row">
    <div class="col-md-12">
      <h2>Property Lettings</h2>
      <hr>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <form method="get" action="/search/lettings/results" class="form-horizontal">

        <div class="form-group">
          <label class="col-sm-3 control-label" for="priceLow">Rent From</label>
          <div class="col-sm-5">
            <select class="form-control" id="priceLow" name="priceLow">
              <option value="0">No Minimum</option>
              <% for (var p = 500; p <= 1000; p += 50) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
              <% for (var p = 1100; p <= 2000; p += 100) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
              <% for (var p = 2250; p <= 5000; p += 250) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
              <% for (var p = 5500; p <= 10000; p += 500) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="priceHigh">Rent To</label>
          <div class="col-sm-5">
            <select class="form-control" id="priceHigh" name="priceHigh">
              <option value="0">No Maximum</option>
              <% for (var p = 500; p <= 1000; p += 50) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
              <% for (var p = 1100; p <= 2000; p += 100) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
              <% for (var p = 2250; p <= 5000; p += 250) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
              <% for (var p = 5500; p <= 10000; p += 500) { %>
                <option value="<%= p %>">£<%= p.toLocaleString('en-GB') %> pcm</option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="beds">Bedrooms</label>
          <div class="col-sm-5">
            <select class="form-control" id="beds" name="beds">
              <option value="">Any</option>
              <option value="0">Studio</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5+</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="proType">Property Type</label>
          <div class="col-sm-5">
            <select class="form-control" id="proType" name="proType">
              <option value="">Any</option>
              <option value="House">House</option>
              <option value="Flat">Flat</option>
              <option value="Studio">Studio</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="area">Area</label>
          <div class="col-sm-5">
            <select class="form-control" id="area" name="area">
              <option value="">All Areas</option>
              <option value="Ladbroke Grove">Ladbroke Grove</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="postcode">Postcode</label>
          <div class="col-sm-5">
            <input type="text" class="form-control" id="postcode" name="postcode" placeholder="e.g. W2">
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="orderBy">Order By</label>
          <div class="col-sm-5">
            <select class="form-control" id="orderBy" name="orderBy">
              <option value="PriceAsk">Lowest price first</option>
              <option value="PriceAskd">Highest price first</option>
              <option value="Postcode">Post Code</option>
              <option value="Address4">Area</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-3 control-label" for="perPage">Properties Per Page</label>
          <div class="col-sm-5">
            <select class="form-control" id="perPage" name="perPage">
              <option value="5">5</option>
              <option value="7">7</option>
              <option value="10" selected>10</option>
              <option value="15">15</option>
              <option value="20">20</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <div class="col-sm-offset-3 col-sm-9">
            <button type="submit" class="btn btn-primary">Search</button>
            &nbsp;
            <a href="/search/lettings/results" class="btn btn-default">View All</a>
            &nbsp;
            <button type="reset" class="btn btn-default">Reset</button>
          </div>
        </div>

      </form>
    </div>

    <div class="col-md-4">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title">Fast Searches</h3>
        </div>
        <div class="panel-body">

          <h5><strong>By Bedrooms</strong></h5>
          <ul class="list-unstyled">
            <li><a href="/search/lettings/results?beds=0">Studio properties</a></li>
            <li><a href="/search/lettings/results?beds=1">1 Bedroom properties</a></li>
            <li><a href="/search/lettings/results?beds=2">2 Bedroom properties</a></li>
            <li><a href="/search/lettings/results?beds=3">3 Bedroom properties</a></li>
            <li><a href="/search/lettings/results?beds=4">4 Bedroom properties</a></li>
            <li><a href="/search/lettings/results?beds=5">5+ Bedroom properties</a></li>
          </ul>

          <h5><strong>By Rent Range</strong></h5>
          <ul class="list-unstyled">
            <li><a href="/search/lettings/results?priceLow=0&priceHigh=750">Under £750 pcm</a></li>
            <li><a href="/search/lettings/results?priceLow=750&priceHigh=1000">£750 – £1,000 pcm</a></li>
            <li><a href="/search/lettings/results?priceLow=1000&priceHigh=1500">£1,000 – £1,500 pcm</a></li>
            <li><a href="/search/lettings/results?priceLow=1500&priceHigh=2000">£1,500 – £2,000 pcm</a></li>
            <li><a href="/search/lettings/results?priceLow=2000&priceHigh=3000">£2,000 – £3,000 pcm</a></li>
            <li><a href="/search/lettings/results?priceLow=3000&priceHigh=5000">£3,000 – £5,000 pcm</a></li>
            <li><a href="/search/lettings/results?priceLow=5000&priceHigh=0">Over £5,000 pcm</a></li>
          </ul>

        </div>
      </div>
    </div>
  </div>
</div>
