
<div class="row">
  <div class="col-md-10 col-md-offset-1">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">User Details</h3>
      </div>
      <div class="panel-body">

        <form>

          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label>Title</label>
                <input type="text" class="form-control" value="<%= userData.title %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>First Name</label>
                <input type="text" class="form-control" value="<%= userData.fst_name %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>Last Name</label>
                <input type="text" class="form-control" value="<%= userData.lst_name %>" disabled>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Email</label>
            <input type="text" class="form-control" value="<%= userData.email %>" disabled>
          </div>

          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label>Phone (Day)</label>
                <input type="text" class="form-control" value="<%= userData.phone_day %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>Phone (Evening)</label>
                <input type="text" class="form-control" value="<%= userData.phone_eve %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>Phone (Mobile)</label>
                <input type="text" class="form-control" value="<%= userData.phone_mob %>" disabled>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Areas</label>
            <input type="text" class="form-control" value="<%= userData.areas %>" disabled>
          </div>

          <div class="form-group">
            <label>Property For</label>
            <input type="text" class="form-control" value="<%= userData.property_for %>" disabled>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Min Amount</label>
                <input type="text" class="form-control" value="<%= userData.min_amount %>" disabled>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>Max Amount</label>
                <input type="text" class="form-control" value="<%= userData.max_amount %>" disabled>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label>Bedrooms</label>
                <input type="text" class="form-control" value="<%= userData.bedrooms %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>Property Type</label>
                <input type="text" class="form-control" value="<%= userData.property_type %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>Required From Date</label>
                <input type="text" class="form-control" value="<%= userData.req_frm_date %>" disabled>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Special Requirements</label>
            <input type="text" class="form-control" value="<%= userData.spec_req %>" disabled>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Known By</label>
                <input type="text" class="form-control" value="<%= userData.known_by %>" disabled>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>Occupation</label>
                <input type="text" class="form-control" value="<%= userData.occupation %>" disabled>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Living Status</label>
                <input type="text" class="form-control" value="<%= userData.living_status %>" disabled>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>Current Position</label>
                <input type="text" class="form-control" value="<%= userData.current_position %>" disabled>
              </div>
            </div>
          </div>

          <hr>
          <h4>Current Address</h4>

          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label>Flat No</label>
                <input type="text" class="form-control" value="<%= userData.flat_no %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>Building Name</label>
                <input type="text" class="form-control" value="<%= userData.building_name %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>House No</label>
                <input type="text" class="form-control" value="<%= userData.house_no %>" disabled>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Street</label>
            <input type="text" class="form-control" value="<%= userData.street %>" disabled>
          </div>

          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label>City</label>
                <input type="text" class="form-control" value="<%= userData.city %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>State</label>
                <input type="text" class="form-control" value="<%= userData.state %>" disabled>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label>Postal Code</label>
                <input type="text" class="form-control" value="<%= userData.postalcode %>" disabled>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Country</label>
            <input type="text" class="form-control" value="<%= userData.country %>" disabled>
          </div>

          <div class="form-group">
            <label>Additional Message</label>
            <input type="text" class="form-control" value="<%= userData.add_msg %>" disabled>
          </div>

        </form>

        <a href="/admin/users" class="btn btn-default">
          <i class="fa fa-arrow-left"></i> Back to Users
        </a>

      </div>
    </div>
  </div>
</div>
