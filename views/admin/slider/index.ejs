
<div class="row">

  <!-- Add New Image -->
  <div class="col-lg-4">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">Add New Image</h3>
      </div>
      <div class="panel-body">
        <form method="POST" action="/admin/slider/add" enctype="multipart/form-data">

          <div class="form-group text-center">
            <img id="preview-img" src="/img/default_img.png" class="img-responsive img-thumbnail" alt="Preview" style="max-height: 200px; margin: 0 auto 10px;">
          </div>

          <div class="form-group">
            <label>Image File</label>
            <input type="file" name="img_file" required accept="image/*" onchange="previewImage(this, 'preview-img')">
          </div>

          <div class="form-group">
            <label>Title</label>
            <input type="text" class="form-control" name="dis_text" required placeholder="Give a title for the image">
          </div>

          <div class="form-group">
            <label>Position</label>
            <input type="number" class="form-control" name="pos" min="1" required placeholder="Position">
          </div>

          <div class="form-group">
            <label>Status</label>
            <select class="form-control" name="status">
              <option value="1">Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            <i class="fa fa-plus"></i> Add
          </button>

        </form>
      </div>
    </div>
  </div>

  <!-- Existing Images -->
  <div class="col-lg-8">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">Existing Images</h3>
      </div>
      <div class="panel-body">

        <% if (sliders && sliders.length > 0) { %>
          <% sliders.forEach(function(slider, index) { %>
            <div class="panel panel-default">
              <div class="panel-body">
                <form method="POST" action="/admin/slider/update/<%= slider._id %>" enctype="multipart/form-data">

                  <div class="row">
                    <div class="col-md-4 text-center">
                      <img id="slider-preview-<%= index %>" src="<%= slider.img_url %>" class="img-responsive img-thumbnail" alt="Slider Image" style="max-height: 150px; margin: 0 auto 10px;">
                      <div class="form-group">
                        <label>Replace Image (optional)</label>
                        <input type="file" name="img_file" accept="image/*" onchange="previewImage(this, 'slider-preview-<%= index %>')">
                      </div>
                    </div>

                    <div class="col-md-8">
                      <div class="form-group">
                        <label>Title</label>
                        <input type="text" class="form-control" name="dis_text" value="<%= slider.dis_text %>" required>
                      </div>

                      <div class="form-group">
                        <label>Position</label>
                        <input type="number" class="form-control" name="pos" value="<%= slider.pos %>" min="1" required>
                      </div>

                      <div class="form-group">
                        <label>Status</label>
                        <select class="form-control" name="status">
                          <option value="1" <%= slider.status == 1 ? 'selected' : '' %>>Active</option>
                          <option value="0" <%= slider.status == 0 ? 'selected' : '' %>>Inactive</option>
                        </select>
                      </div>

                      <button type="submit" class="btn btn-info">
                        <i class="fa fa-refresh"></i> Update
                      </button>
                    </div>
                  </div>

                </form>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-muted">No slider images found.</p>
        <% } %>

      </div>
    </div>
  </div>

</div>

<script>
  function previewImage(input, previewId) {
    if (input.files && input.files[0]) {
      var reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById(previewId).src = e.target.result;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
